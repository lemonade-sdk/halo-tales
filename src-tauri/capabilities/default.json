{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for HaloTales",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "core:path:default",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "dialog:default",
    "opener:default",
    "shell:default",
    "fs:default",
    "http:default",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/.cache/halo-tales/**" },
        { "path": "$APPCACHE/halo-tales/**" }
      ]
    }
  ]
}
